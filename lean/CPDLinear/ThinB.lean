    have h_bdd : Bornology.IsBounded (clusterValues Θ v μ) := by
      obtain ⟨⟨a', ha'⟩, ⟨b', hb'⟩⟩ := hcv_bdd μ hμ
      exact isBounded_iff_forall_norm_le.mpr ⟨|a'| + |b'| + 1, fun x hx => by
