          _ < 1 / (n + 1) + ε / 2 := add_lt_add (hk n).1 (hN1 n (le_trans (le_max_left _ _) hn))
          _ < ε / 2 + ε / 2 := by linarith [hN2 n (le_trans (le_max_right _ _) hn)]
          _ = ε := by ring
