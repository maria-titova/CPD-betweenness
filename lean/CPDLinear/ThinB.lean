            have hx_seg : x ∈ segment ℝ a b := by
              rw [segment_eq_image']
              have h3' : (x - a) / (b - a) ∈ Set.Icc (0 : ℝ) 1 := ⟨h3, by
                rw [div_le_one (by linarith : 0 < b - a)]
                linarith [hx.2]⟩
              use (x - a) / (b - a)
              refine ⟨h3', ?_⟩
              rw [hx_eq]
              simp [smul_eq_mul]
              field_simp
              ring
            rw [← hx_eq]
            exact hseg hx_seg
