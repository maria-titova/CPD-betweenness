        have hclose : ∀ n, dist (v (y n)) (ws n) < 1 / (n + 1 : ℝ) := by
          intro n
          simp only [y]
          exact (hk n).2
        rw [Metric.tendsto_atTop]
        intro ε hε
        obtain ⟨N1, hN1⟩ : ∃ N1 : ℕ, ∀ n ≥ N1, 1 / (n + 1 : ℝ) < ε / 2 := by
          use Nat.ceil (2 / ε)
          intro n hn
