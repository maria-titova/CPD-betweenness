    -- Prove closed graph of clusterValues: if μ_n → μ, w_n → w, w_n ∈ clusterValues μ_n,
    -- then w ∈ clusterValues μ
    have hcv_closed_graph : ∀ (μs : ℕ → (T → ℝ)) (μ : T → ℝ) (ws : ℕ → ℝ) (w : ℝ),
