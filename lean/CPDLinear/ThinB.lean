        apply Set.Subset.antisymm
        · -- convexHull ⊆ Icc a b
          intro x hx
          have hsub : clusterValues Θ v μ ⊆ Set.Icc a b := fun y hy => ⟨ha_glb.1 hy, hb_lub.1 hy⟩
