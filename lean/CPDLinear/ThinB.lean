      -- zn is bounded, so has a convergent subsequence
      have hbdd_below' : ∀ μ'' ∈ simplexOn Θ, BddBelow (clusterValues Θ v μ'') := fun μ'' hμ'' => (hcv_bdd μ'' hμ'').1
