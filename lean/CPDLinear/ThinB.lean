        (∀ n, μs n ∈ simplexOn Θ) →
        Tendsto ws atTop (𝓝 w) →
        (∀ n, ws n ∈ clusterValues Θ v (μs n)) →
        w ∈ clusterValues Θ v μ := by
      intro μs μ ws w hμs_tend hμs_mem hws_tend hws_in
      -- For each w_n ∈ clusterValues μ_n, there's a sequence x_n,k → μ_n with v(x_n,k) → w_n
