        intro n
        have := Metric.tendsto_atTop.mp (hx_tend n) (1 / (n + 1)) (by positivity)
        obtain ⟨k₁, hk₁⟩ := this
        have := Metric.tendsto_atTop.mp (hv_tend n) (1 / (n + 1)) (by positivity)
        obtain ⟨k₂, hk₂⟩ := this
